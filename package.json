{
  "name": "3d-virtual-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-wasm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:models": "node scripts/generate-glasses.mjs && node scripts/generate-occluder.mjs && node scripts/generate-showroom.mjs && node scripts/generate-face-mesh.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "draco3dgltf": "1.5.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
